@using Microsoft.AspNetCore.Components

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    [Parameter] public string? Message { get; set; }  // optional direct message

    private string? _msg;

    protected override void OnParametersSet()
    {
        // Prefer explicit Message param; otherwise read from querystring "status"
        _msg = !string.IsNullOrWhiteSpace(Message) ? Message : GetQueryParam("status");
    }

    private string? GetQueryParam(string key)
    {
        try
        {
            var uri = new Uri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var raw = query[key];
            return string.IsNullOrWhiteSpace(raw) ? null : raw;
        }
        catch { return null; }
    }

    private string CssClass =>
        string.IsNullOrWhiteSpace(_msg) ? ""
        : (_msg.StartsWith("Error:", StringComparison.OrdinalIgnoreCase) ? "text-danger" : "text-success");
}

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="@CssClass" role="status">@_msg</div>
}
